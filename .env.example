# Connexion Postgres (Aiven) avec SSL obligatoire
DATABASE_URL=postgres://tce_backend:<MOT_DE_PASSE>@pg-33ce8135-tce-oreegami.a.aivencloud.com:26149/defaultdb?sslmode=require

# Optionnel : variables décomposées si DATABASE_URL n'est pas fourni
# DB_HOST=pg-33ce8135-tce-oreegami.a.aivencloud.com
# DB_PORT=26149
# DB_NAME=defaultdb
# DB_USER=tce_backend
# DB_PWD=

# Identifiant du collecteur envoyé à chaque requête HTTP
USER_AGENT=TCE-Collector/0.1.0 (+https://github.com/your-org/tce; contact@example.com)

# Niveau de journalisation
LOG_LEVEL=INFO
